# Postgres (Vercel Postgres / Neon connection string)
DATABASE_URL=postgres://...

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
# This email may sign up without an invite code (bootstrap the first admin)
ADMIN_EMAIL=you@example.com

# S3 (private bucket)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Vercel Cron auth (Vercel sends this as a Bearer token)
CRON_SECRET=

# Optional: S3-compatible endpoint for local dev (MinIO from docker-compose)
# S3_ENDPOINT=http://localhost:9000
