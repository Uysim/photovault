{
  "expo": {
    "name": "PhotoVault",
    "slug": "photovault",
    "scheme": "photovault",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.example.photovault",
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.photovault",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "PhotoVault needs access to your photos and videos so you can upload them."
        }
      ],
      "expo-video",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b41e27a5-57bd-4b16-9d83-f4909d080f4d"
      }
    },
    "owner": "uysim"
  }
}
